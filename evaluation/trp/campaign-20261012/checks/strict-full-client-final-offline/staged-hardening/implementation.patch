+def strict_success_gates(events, record, bundle):
+    """Require the declared workflow gates and their retained source records.
+    This is mandatory-path consistency, not an independent callback/human oracle.
+    """
+    protocol = record('protocol.json')
+    expected = [('admission', 'accepted-for-review'),
+                ('protocol', 'checked' if protocol['check']['committed'] else 'not-committed'),
