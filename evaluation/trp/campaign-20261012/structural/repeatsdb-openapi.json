{
  "openapi": "3.0.0",
  "paths": {
    "/production/classification": {
      "get": {
        "operationId": "ClassificationSearchController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/ClassificationDto"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "statistics": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "source": {
                                  "type": "string"
                                },
                                "author": {
                                  "type": "string"
                                },
                                "structures": {
                                  "type": "number"
                                },
                                "chains": {
                                  "type": "number"
                                },
                                "regions": {
                                  "type": "number"
                                },
                                "units": {
                                  "type": "number"
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "tags": [
          "production"
        ]
      }
    },
