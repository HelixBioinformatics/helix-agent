+CAPTURED['source'] = CAPTURED['source'].replace('ubuntu(1000)', f'synthetic({os.getuid()})')
+OWNER = 'a8a4d2eb-8601-4c0a-a1c9-ba96d1abcf87'
+REQ = {'id': OWNER, 'digest': 'a'*64, 'target': {'root': '/unused', 'version': runner.VERSION}}
