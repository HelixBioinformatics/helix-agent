+def strict_success_gates(events, record, bundle):
+    """Require the declared workflow gates and their retained source records.
+    This is mandatory-path consistency, not an independent callback/human oracle.
+    """
+    protocol = record('protocol.json')
+    expected = [('admission', 'accepted-for-review'),
+                ('protocol', 'checked' if protocol['check']['committed'] else 'not-committed'),
+                ('permission', 'requested'), ('permission', 'returned-allowed'),
+                ('approval', 'requested'), ('approval', 'answered'),
+                ('admission', 'recheck-accepted'), ('execution', 'remote-started'),
+                ('admission', 'analysis-accepted'), ('execution', 'completed')]
+    sources = [(event['source'], event['outcome']) for event in events]
+    positions = []
+    for pair in expected:
+        if sources.count(pair) != 1:
+            raise ValueError('strict successful gate missing/duplicated: ' + repr(pair))
+        positions.append(sources.index(pair))
+    if positions != sorted(positions):
+        raise ValueError('strict successful gate order differs')
+    selected = [events[i] for i in positions]
+    for event in selected:
+        detail = event['detail']
+        if 'digest' in detail and detail['digest'] != bundle['digest']:
+            raise ValueError('strict event proposal digest differs')
+    approval = record('approval.json')
+    if approval['digest'] != bundle['digest'] or approval.get('channel') != 'Question.Service' or approval.get('answer') != 'Aprobar y ejecutar':
+        raise ValueError('strict approval channel/answer/digest differs')
+    if (selected[0]['detail'] != record('admission.json') or selected[1]['detail'] != protocol
+        or selected[5]['detail'].get('answers') != [['Aprobar y ejecutar']]
+        or selected[6]['detail'] != record('recheck.json')['decision']
+        or selected[8]['detail'] != record('analysis-admission.json')['decision']
+        or selected[7]['detail'].get('controller') != record('remote-controller-identity.json')):
+        raise ValueError('strict gate retained source differs')
+    run = record('run.json')
+    if selected[9]['detail'].get('geometry') != run['geometry'] or selected[9]['detail'].get('measuredTasks') != run['measuredTasks']:
+        raise ValueError('strict completion gate source differs')
+
