  "info": {
    "title": "RepeatsDB & Bio-curation Tool Endpoints",
    "description": "Complete description of APIs used by RepeastDB and the Bio-curation Tool",
    "version": "2.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "production",
      "description": "Production endpoints, used by the RepeatsDB main interface"
    },
    {
      "name": "staging",
      "description": "Staging endpoints, used by the RepeatsDB Bio-curation Tool"
    },
    {
      "name": "authentication",
      "description": "Authorization and authentication endpoints, for the RepeatsDB Bio-curation Tool"
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "ClassificationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier",
            "example": "1"
          },
          "name": {
            "type": "string",
            "description": "Full name",
            "example": "Alpha/Beta Barrel"
          },
          "description": {
            "type": "string",
            "description": "Description",
            "example": "Alpha/Beta Barrel"
          },
          "wikipedia": {
            "type": "string",
            "description": "Link to Wikipedia page",
            "example": "https://en.wikipedia.org/wiki/Alpha/Beta_Barrel"
          },
          "representative": {
            "type": "string",
            "description": "Structure, chain identifier of RCSB/PDB representative structure",
            "example": "1a0aA"
          },
          "version": {
            "type": "string",
            "description": "Version of the classification, usually set in root element",
            "example": "1.0.0"
          },
          "release": {
            "type": "string",
            "description": "Release of the classification, usually set in root element as ISO date",
            "example": "2022-01-01T00:00:00Z"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "NodeDto": {
        "type": "object",
        "properties": {}
      },
      "AnnotationDto": {
        "type": "object",
        "properties": {
          "loci": {
            "description": "List of loci",
            "example": [
              {
                "type": "region",
                "start": "0",
                "end": "100",
                "class": "alpha"
              },
              {
                "type": "unit",
                "start": "0",
                "end": "10",
                "parent": 0
              }
            ],
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "chain": {
            "type": "object",
            "description": "Chain",
            "example": {
              "id": "1",
              "structure": "1a0a",
              "source": "PDB",
              "hash": ""
            }
          },
          "comment": {
            "type": "string"
          },
          "features": {
            "type": "object",
            "description": "Features of the annotation",
            "example": {
              "feature": "value"
            }
          }
        },
        "required": [
          "loci",
          "chain"
        ]
      }
    }
  }
}
