        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "type": "object",
                      "properties": {
                        "content": {
                          "$ref": "#/components/schemas/AnnotationDto"
                        }
                      }
                    },
                    {
                      "$ref": "#/components/schemas/NodeDto"
                    }
                  ]
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "production"
