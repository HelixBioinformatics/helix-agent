manifest.nextflowVersion = '25.10.4'
process.executor = 'local'
process.container = 'sha256:1dd91e70acb153a0bd9a51346fc001dd5025f851c9598697cdd37f07d9490b0a'
process.cpus = 2
process.memory = '2 GB'
process.time = '3 min'
process.errorStrategy = 'terminate'
process.maxRetries = 0
process.maxForks = 1
docker.enabled = true
docker.runOptions = '--entrypoint="" --user $(id -u):$(id -g) --network none --read-only --cap-drop ALL --security-opt no-new-privileges --pids-limit 128 --cpus 2 --tmpfs /tmp:rw,nosuid,size=256m'
env.OPENBLAS_NUM_THREADS = '1'
env.OMP_NUM_THREADS = '1'
env.MKL_NUM_THREADS = '1'
